{
  "name": "usahaku",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "migrate": "npm run migrate -w apps/api",
    "test": "npm test -w apps/api && npm test -w apps/web",
    "lint": "eslint . && prettier --check \"apps/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"apps/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\"",
    "build": "npm run build -w apps/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
